<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="NASsie"
           Manufacturer="Lister Creative Enterprise LLC"
           Version="0.1.24.0"
           UpgradeCode="4c2e7f0a-9b1d-4e3a-8c6f-2a1b5d7e9f30"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: Package/@Id (ProductCode) is left
         unpinned, so every build gets a fresh auto-generated GUID (the
         standard, recommended WiX practice) - but Version here doesn't
         change between test rebuilds. Without this, WiX's default
         upgrade-detection range excludes the exact current version, so
         reinstalling the same version (new ProductCode, same Version) is
         invisible to MajorUpgrade's logic entirely: it neither upgrades
         nor blocks, it just installs as a second, unrelated product -
         which is exactly how NASsie ended up installable multiple times. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of NASsie is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="NASsieIcon" SourceFile="nassie_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="NASsieIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NASsie">
        <Component Id="MainExecutable" Guid="6e1e9f53-8c4b-4e01-9c39-4d5e12a9b701">
          <File Id="NASsieExe" Source="NASsie.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="NASsie">
        <Component Id="ApplicationShortcut" Guid="1b7c9e24-3a2d-4f6b-9e01-7c8d4a6b2e15">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="NASsie"
                    Target="[INSTALLFOLDER]NASsie.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="NASsieIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                          Key="Software\NASsie"
                          Name="installed"
                          Type="integer"
                          Value="1"
                          KeyPath="yes" />
          <!-- %APPDATA%\NASsie holds tour.py's own "has the guided tour
               been seen before" marker (tour_seen) - per-user profile
               data, entirely outside INSTALLFOLDER, that nothing else in
               this file's Directory/Component tree ever touches. Left
               behind across an uninstall, a later reinstall on the same
               machine found that stale marker and offered to "Resume"
               a tour instead of just starting fresh - wrong for what is,
               from that reinstall's own perspective, a brand new install.
               core.py's prompt_uninstall_folders_windows() also deletes
               this marker directly (see its own comment) as the primary
               fix, correctly resolving the real interactive user's
               %APPDATA% rather than guessing - but that's an immediate
               custom action, and this project's own prior testing found
               Settings > Apps > Uninstall (confirmed by testing) runs the
               whole uninstall silently, where an immediate custom action
               often can't even run at all (see uninstall_cleanup_windows()'s
               docstring). This RemoveFolderEx is the belt to that belt-
               and-suspenders: an MSI-native removal the installer engine
               itself performs, tied to this same per-user (HKCU-keyed)
               Component so it only ever fires for a genuine uninstall of
               this component, not a repair/upgrade - and unlike the
               custom action, it doesn't depend on any of our own code
               actually getting to run. AppDataFolder is a standard MSI
               directory property (CSIDL_APPDATA) the engine resolves
               fresh for whichever user context is running THIS
               transaction, so NASsieAppDataDir below re-evaluates
               correctly at uninstall time too, not just at install. -->
          <!-- Condition matches InstallExecuteSequence's own two Custom
               Action guards below exactly, and for the same reason: On=
               "uninstall" alone isn't enough to mean "only a genuine
               standalone uninstall" - a MajorUpgrade's own removal of the
               OLD product version (RemoveExistingProducts) is ALSO an
               "uninstall" as far as component-removal scheduling is
               concerned. Without this, every ordinary future update
               would wipe %APPDATA%\NASsie the moment the old version's
               components get removed as part of installing the new one -
               which for tour_seen specifically would be a strictly worse
               regression than the stale-marker bug this exists to fix:
               EVERY user, on EVERY update, would have their tour state
               reset and see it auto-start again from step one. -->
          <util:RemoveFolderEx On="uninstall" Property="NASsieAppDataDir"
                                Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="NASsie" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- NASsie-created local users/groups live outside the app entirely -
         nothing else would ever clean them up. Runs before files are
         removed, only on a genuine uninstall (never as part of an
         upgrade's remove-old-version step, which would otherwise wipe out
         every share's accounts on every update). Impersonate="no" and
         deferred execution run this with the same admin rights the MSI
         itself already has; Return="ignore" means a cleanup failure can
         never block the uninstall from completing. -->
    <CustomAction Id="NASsieUninstallCleanup"
                  FileRef="NASsieExe"
                  ExeCommand="--uninstall-cleanup"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- NASsieUninstallCleanup above runs deferred as SYSTEM, which is
         required to reliably get admin rights for account/group deletion,
         but a SYSTEM-context deferred action can't show UI on the user's
         desktop at all (Windows session isolation). So folder-deletion
         choices are collected separately here, by an *immediate* action
         (default Execute, runs in the same interactive session as the
         uninstall itself) that writes them to a temp file; the deferred
         step above reads that file. Any failure here - the dialog can't
         show, the user closes it, whatever - simply results in no file
         being written, which the deferred step treats as "delete
         nothing," never the reverse. -->
    <CustomAction Id="NASsiePromptUninstallFolders"
                  FileRef="NASsieExe"
                  ExeCommand="--uninstall-folder-prompt"
                  Return="ignore" />

    <!-- Deletes tour.py's own "guided tour already seen" marker so a
         later reinstall on this machine starts the tour fresh instead of
         offering to resume one - see delete_tour_marker_windows()'s own
         (long) comment for the full chase across three failed
         configurations before landing here. Short version: launching
         NASsie.exe from ANY impersonated custom action - immediate or
         deferred - reliably failed with MSI error 1721 ("a program
         required for this install to complete could not be run") under
         this elevated, MSI_LUA ("split token" UAC) execution path,
         confirmed via multiple verbose-logged uninstalls. The ONE
         configuration proven to work across every one of those logs is
         NASsieUninstallCleanup's: Execute="deferred" AND
         Impersonate="no" (running as SYSTEM, not impersonating the
         calling user at all) - matched exactly here. Running as SYSTEM
         means %APPDATA% would resolve to SYSTEM's own profile, not the
         real user's, so delete_tour_marker_windows() doesn't rely on
         %APPDATA% resolution at all - see its own comment for how it
         finds the real marker instead.

         (A WiX-native util:RemoveFolderEx targeting the same folder was
         also tried, as an MSI-native alternative that wouldn't depend on
         our own exe running at all - see ApplicationShortcut's own
         comment on why that's still left in place despite being blocked
         on this particular test machine: %APPDATA%\NASsie turned out to
         be a reparse point/junction there, and RemoveFolderEx's own
         shipped CA hard-codes a refusal to recurse into any reparse
         point, with no attribute to override it.) -->
    <CustomAction Id="NASsieDeleteTourMarker"
                  FileRef="NASsieExe"
                  ExeCommand="--uninstall-delete-tour-marker"
                  Impersonate="no"
                  Execute="deferred"
                  Return="ignore" />

    <!-- "Add desktop shortcut" checkbox on the final install page (see
         NASsieExitDialog below). Plain ExeCommand rather than
         WixShellExec (used for LaunchApplication below) because
         WixShellExec has no way to pass an argument (like the
         ExeCommand flag below) - it just ShellExecutes the target file
         as-is. Impersonate="yes" (default Execute, immediate, same
         interactive session as the rest of the UI) runs this as the
         logged-in user, not the elevated installer - see
         create_desktop_shortcut_windows()'s docstring for why that
         matters (resolving the right Desktop folder). Return="ignore"
         means a failure here (e.g. PowerShell/WScript.Shell unavailable)
         can never block Finish from completing. -->
    <CustomAction Id="NASsieCreateDesktopShortcut"
                  FileRef="NASsieExe"
                  ExeCommand="--create-desktop-shortcut"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="NASsieDeleteTourMarker" Before="NASsiePromptUninstallFolders" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="NASsiePromptUninstallFolders" Before="NASsieUninstallCleanup" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="NASsieUninstallCleanup" Before="RemoveFiles" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Standard WixUI branding slots: banner.bmp (493x58) is the thin
         strip atop every dialog after Welcome/Exit; dialog.bmp (493x312)
         is the full background behind Welcome/Exit itself. Both generated
         from assets/nassie_icon.png - see packaging/windows/README.md if
         they ever need regenerating from a different source image. -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Feeds ApplicationShortcut's util:RemoveFolderEx (see its own
         comment) - AppDataFolder is a standard MSI directory property
         (CSIDL_APPDATA), always available with no AppSearch/RegistrySearch
         needed (unlike a real installer-defined directory such as
         INSTALLFOLDER), and re-resolved fresh by the engine for whichever
         user context runs the CURRENT transaction - install or uninstall
         alike - so this correctly points at the actual uninstalling
         user's %APPDATA%, not a value frozen from install time. -->
    <Property Id="NASsieAppDataDir" Value="[AppDataFolder]NASsie" />

    <!-- NOT "<ui:WixUI Id="WixUI_InstallDir" />" (the normal shortcut for
         this dialog set) - see the WixUI_NASsieInstallDir Fragment at the
         bottom of this file for why. UIRef, not ui:WixUI, since
         WixUI_NASsieInstallDir is our own plain <UI> fragment, not
         something the ui: extension element knows how to resolve. -->
    <UIRef Id="WixUI_NASsieInstallDir" />

    <!-- "Launch NASsie" checkbox on the final install page. The checkbox's
         checked-state is its own property, separate from its label text -
         setting only the text left it unchecked by default (an MSI
         property with no explicit value starts unset/false), so nothing
         launched unless a user happened to tick a box that wasn't obviously
         asking to be ticked. Pre-set to checked so launching is the default,
         opt-out behavior most installers use.
         WixShellExec (from the Util extension) is the standard way to run
         an arbitrary file from a custom action; Impersonate="yes" runs it
         as the logged-in user rather than as the elevated installer. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NASsie" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NASsieExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- The stock WixUI_InstallDir ExitDialog (from the UI extension
         library) has room for exactly one opt-in checkbox
         (WIXUI_EXITDIALOGOPTIONALCHECKBOX, used above for "Launch NASsie")
         - getting a second, independent one ("Add desktop shortcut") means
         replacing that whole dialog with our own copy.

         This is named "NASsieExitDialog", NOT "ExitDialog" - a same-Id
         override was the first thing tried here, and it doesn't work in
         current WiX: the extension's own <Dialog Id="ExitDialog"> (and
         every <Control> inside it) is a plain, non-virtual symbol, so a
         second same-Id Dialog elsewhere in the same build is a hard
         WIX0091 duplicate-symbol error, not a "last definition wins"
         override - confirmed live, this is exactly the error that showed
         up switching to this WiX toolset version. Renaming the dialog
         alone isn't enough either, though: <ui:WixUI Id="WixUI_InstallDir">
         itself contains a `<Publish Dialog="ExitDialog" Control="Finish"
         Event="EndDialog" .../>` line, and THAT reference is what actually
         pulls the stock ExitDialog fragment into the link at all - so as
         long as that shortcut element is used, the stock dialog (and its
         own `<Show Dialog="virtual ExitDialog" OnExit="success" />`,
         fighting ours for the same "install just finished" slot) stays
         linked in regardless of what our own dialog is named. Fixed by
         forking the WixUI_InstallDir dialog-sequence wiring itself (see
         the WixUI_NASsieInstallDir Fragment at the bottom of this file) -
         a verbatim copy of the real upstream WixUI_InstallDir.wxs content
         with that one Publish line removed, so the stock ExitDialog
         fragment is never referenced, never linked in, and never
         conflicts with this one.

         Every control below except NASsieDesktopShortcutCheckBox, and
         every coordinate, is copied verbatim from the library's own
         ExitDialog.wxs so the rest of the dialog looks identical; only
         OptionalCheckBox's Height shrank (40 to 18, it doesn't need to
         wrap) to make room for the new checkbox directly beneath it,
         still well clear of BottomLine at Y=234. -->
    <UI>
      <Dialog Id="NASsieExitDialog" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogTitle)" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="190" Width="220" Height="18" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
        <!-- Unchecked by default (NASSIE_DESKTOP_SHORTCUT has no Property
             element declaring a starting value, so it's unset/false until
             ticked) - unlike launching the app you just installed, a
             desktop icon is a personal-clutter preference, not something
             to assume everyone wants. -->
        <Control Id="NASsieDesktopShortcutCheckBox" Type="CheckBox" X="135" Y="210" Width="220" Height="18" Property="NASSIE_DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Add a desktop shortcut" ShowCondition="NOT Installed" />
      </Dialog>

      <!-- Takes over the "installation just finished successfully" slot
           the stock ExitDialog.wxs's own identical Show entries (see this
           file's own copy, in InstallUISequence/AdminUISequence) would
           otherwise occupy - safe to do unconditionally (no "virtual"
           needed on this side) precisely because that stock fragment is
           never linked in at all now (see the long comment above). -->
      <InstallUISequence>
        <Show Dialog="NASsieExitDialog" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="NASsieExitDialog" OnExit="success" />
      </AdminUISequence>

      <Publish Dialog="NASsieExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="NASsieExitDialog" Control="Finish" Event="DoAction" Value="NASsieCreateDesktopShortcut"
               Condition="NASSIE_DESKTOP_SHORTCUT = 1 and NOT Installed" />
      <!-- Stock ExitDialog.wxs's own "Finish" Control has no nested
           EndDialog Publish either - that binding comes entirely from a
           separate top-level rule in WixUI_InstallDir.wxs:
           `<Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog"
           Value="Return" Order="999" />`. That's the exact line the
           WixUI_NASsieInstallDir Fragment (bottom of this file)
           intentionally omits, since it's what pulled the stock,
           non-overridable ExitDialog into the link. Omitting it there
           without adding an equivalent rule HERE, targeting
           NASsieExitDialog, meant Finish did its DoAction(s) and then
           nothing ever told the dialog to close - the installer sat open
           forever, and since Finish has Cancel="yes" above (matching
           stock exactly - there's nothing left to "cancel" once install
           has succeeded), the window's native [X] close button triggers
           the exact same stuck behavior. Order="999" (matching upstream)
           keeps this after the DoAction rules above, so the app/shortcut
           actions still fire before the dialog tears itself down. -->
      <Publish Dialog="NASsieExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

  </Package>

  <!-- Our own fork of the stock WixUI_InstallDir dialog-sequence wiring -
       see NASsieExitDialog's own comment (in Package, above) for why this
       has to exist at all rather than just using
       "<ui:WixUI Id="WixUI_InstallDir" />" directly. This is based on the
       real upstream source pinned to the exact WiX version build.ps1
       installs - wixtoolset/wix tag v5.0.2,
       src/ext/UI/wixlib/WixUI_InstallDir.wxs, the plain non-arch-specific
       "file WixUI_InstallDir" fragment (not the WIXUIARCH-templated
       variants above it in that file, which this project's own
       <ui:WixUI Id="WixUI_InstallDir" /> never used either). An earlier
       version of this Fragment was copied from that file's DEFAULT-BRANCH
       content instead of the v5.0.2 tag, which turned out to differ
       enough (different Order values, a different BrowseDlg/InstallDirDlg
       rule set) to cause two real bugs: a WIX0130 duplicate-ControlEvent
       build failure (see the InstallDirDlg/BrowseDlg comment below) and,
       separately, an InstallDirDlg "Next" that would have set the target
       path and then never actually advanced to VerifyReadyDlg. Relative
       to the real v5.0.2 "file WixUI_InstallDir" fragment, two things
       differ here: the
       `<Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog"
       Value="Return" Order="999" />` line is removed (it's what pulls the
       stock, non-overridable ExitDialog fragment into the link), and
       WIXUI_DONTVALIDATEPATH="1" is added (see below). Every other
       Publish rule - Welcome/License/InstallDir/VerifyReady/Maintenance
       navigation - matches stock WixUI_InstallDir v5.0.2 exactly. -->
  <Fragment>
    <UI Id="WixUI_NASsieInstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <!-- This block is a verbatim copy of the *plain, non-arch-specific*
           InstallDirDlg/BrowseDlg wiring from the real v5.0.2-tagged
           upstream source (confirmed via `gh api ...?ref=v5.0.2`, which
           differs from the default-branch copy this Fragment was
           originally, incorrectly, based on). Two things had to change
           from the naive "copy every Publish rule" approach:

           1. BrowseDlg's own "OK" button already declares its
              SetTargetPath/EndDialog Publish rules as nested children of
              <Control Id="OK"> inside BrowseDlg.wxs itself (part of the
              stock DialogRef we pull in above). Re-declaring them here as
              top-level <Publish Dialog="BrowseDlg" Control="OK" .../>
              rules - as an earlier version of this fragment did - creates
              an exact duplicate ControlEvent row and fails the build with
              WIX0130. So they're intentionally omitted here.

           2. Upstream's InstallDirDlg/Next "actually advance to
              VerifyReadyDlg" rule is conditioned on
              WIXUI_INSTALLDIR_VALID, which only gets set by a
              WixUIValidatePath_$(WIXUIARCH) custom action wired up in the
              arch-specific WixUI_InstallDir_X86/X64/A64 Fragments (not
              part of the plain fragment we're forking, and not something
              we reference). Without wiring that CA in, Next would set the
              path and then do nothing. We sidestep the whole optional
              validation feature via WIXUI_DONTVALIDATEPATH="1" below,
              which is upstream's own documented knob for skipping it -
              this makes the Order="4" NewDialog rule unconditional in
              practice, matching stock WixUI_InstallDir's default-off
              validation behavior rather than a half-wired one. -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Property Id="WIXUI_DONTVALIDATEPATH" Value="1" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

</Wix>
