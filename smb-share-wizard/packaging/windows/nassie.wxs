<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="NASsie"
           Manufacturer="Lister Creative Enterprise LLC"
           Version="0.1.5.0"
           UpgradeCode="4c2e7f0a-9b1d-4e3a-8c6f-2a1b5d7e9f30"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: Package/@Id (ProductCode) is left
         unpinned, so every build gets a fresh auto-generated GUID (the
         standard, recommended WiX practice) - but Version here doesn't
         change between test rebuilds. Without this, WiX's default
         upgrade-detection range excludes the exact current version, so
         reinstalling the same version (new ProductCode, same Version) is
         invisible to MajorUpgrade's logic entirely: it neither upgrades
         nor blocks, it just installs as a second, unrelated product -
         which is exactly how NASsie ended up installable multiple times. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of NASsie is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="NASsieIcon" SourceFile="nassie_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="NASsieIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NASsie">
        <Component Id="MainExecutable" Guid="6e1e9f53-8c4b-4e01-9c39-4d5e12a9b701">
          <File Id="NASsieExe" Source="NASsie.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="NASsie">
        <Component Id="ApplicationShortcut" Guid="1b7c9e24-3a2d-4f6b-9e01-7c8d4a6b2e15">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="NASsie"
                    Target="[INSTALLFOLDER]NASsie.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="NASsieIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                          Key="Software\NASsie"
                          Name="installed"
                          Type="integer"
                          Value="1"
                          KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="NASsie" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- NASsie-created local users/groups live outside the app entirely -
         nothing else would ever clean them up. Runs before files are
         removed, only on a genuine uninstall (never as part of an
         upgrade's remove-old-version step, which would otherwise wipe out
         every share's accounts on every update). Impersonate="no" and
         deferred execution run this with the same admin rights the MSI
         itself already has; Return="ignore" means a cleanup failure can
         never block the uninstall from completing. -->
    <CustomAction Id="NASsieUninstallCleanup"
                  FileRef="NASsieExe"
                  ExeCommand="--uninstall-cleanup"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- NASsieUninstallCleanup above runs deferred as SYSTEM, which is
         required to reliably get admin rights for account/group deletion,
         but a SYSTEM-context deferred action can't show UI on the user's
         desktop at all (Windows session isolation). So folder-deletion
         choices are collected separately here, by an *immediate* action
         (default Execute, runs in the same interactive session as the
         uninstall itself) that writes them to a temp file; the deferred
         step above reads that file. Any failure here - the dialog can't
         show, the user closes it, whatever - simply results in no file
         being written, which the deferred step treats as "delete
         nothing," never the reverse. -->
    <CustomAction Id="NASsiePromptUninstallFolders"
                  FileRef="NASsieExe"
                  ExeCommand="--uninstall-folder-prompt"
                  Return="ignore" />

    <!-- "Add desktop shortcut" checkbox on the final install page (see the
         overridden ExitDialog below). Plain ExeCommand rather than
         WixShellExec (used for LaunchApplication below) because
         WixShellExec has no way to pass an argument (like the
         ExeCommand flag below) - it just ShellExecutes the target file
         as-is. Impersonate="yes" (default Execute, immediate, same
         interactive session as the rest of the UI) runs this as the
         logged-in user, not the elevated installer - see
         create_desktop_shortcut_windows()'s docstring for why that
         matters (resolving the right Desktop folder). Return="ignore"
         means a failure here (e.g. PowerShell/WScript.Shell unavailable)
         can never block Finish from completing. -->
    <CustomAction Id="NASsieCreateDesktopShortcut"
                  FileRef="NASsieExe"
                  ExeCommand="--create-desktop-shortcut"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="NASsiePromptUninstallFolders" Before="NASsieUninstallCleanup" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="NASsieUninstallCleanup" Before="RemoveFiles" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Standard WixUI branding slots: banner.bmp (493x58) is the thin
         strip atop every dialog after Welcome/Exit; dialog.bmp (493x312)
         is the full background behind Welcome/Exit itself. Both generated
         from assets/nassie_icon.png - see packaging/windows/README.md if
         they ever need regenerating from a different source image. -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- "Launch NASsie" checkbox on the final install page. The checkbox's
         checked-state is its own property, separate from its label text -
         setting only the text left it unchecked by default (an MSI
         property with no explicit value starts unset/false), so nothing
         launched unless a user happened to tick a box that wasn't obviously
         asking to be ticked. Pre-set to checked so launching is the default,
         opt-out behavior most installers use.
         WixShellExec (from the Util extension) is the standard way to run
         an arbitrary file from a custom action; Impersonate="yes" runs it
         as the logged-in user rather than as the elevated installer. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NASsie" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NASsieExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- The stock WixUI_InstallDir ExitDialog (from the UI extension
         library) has room for exactly one opt-in checkbox
         (WIXUI_EXITDIALOGOPTIONALCHECKBOX, used above for "Launch NASsie")
         - getting a second, independent one ("Add desktop shortcut") means
         replacing that whole dialog with our own copy. Overriding it is as
         simple as redefining a Dialog with the same Id elsewhere in the
         same UI sequence - WiX resolves same-Id dialogs by last one wins,
         no separate "virtual"/Overridable declaration needed on this side.
         Every control below except NASsieDesktopShortcutCheckBox, and
         every coordinate, is copied verbatim from the library's own
         ExitDialog.wxs so the rest of the dialog looks identical; only
         OptionalCheckBox's Height shrank (40 to 18, it doesn't need to
         wrap) to make room for the new checkbox directly beneath it,
         still well clear of BottomLine at Y=234. -->
    <UI>
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.ExitDialogTitle)" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="190" Width="220" Height="18" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
        <!-- Unchecked by default (NASSIE_DESKTOP_SHORTCUT has no Property
             element declaring a starting value, so it's unset/false until
             ticked) - unlike launching the app you just installed, a
             desktop icon is a personal-clutter preference, not something
             to assume everyone wants. -->
        <Control Id="NASsieDesktopShortcutCheckBox" Type="CheckBox" X="135" Y="210" Width="220" Height="18" Property="NASSIE_DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Add a desktop shortcut" ShowCondition="NOT Installed" />
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="NASsieCreateDesktopShortcut"
               Condition="NASSIE_DESKTOP_SHORTCUT = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
